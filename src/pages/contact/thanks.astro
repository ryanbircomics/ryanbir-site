---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Chevron from "../../components/Chevron.astro";
---

<Layout
  title="Thank You — Ryan Bir"
  description="Thanks for reaching out to Ryan Bir."
>
  <Nav />

  <main class="flex-1 max-w-4xl mx-auto px-6 py-16 flex flex-col items-start">
    <h1 class="font-display text-5xl md:text-7xl tracking-widest text-text mb-4">
      THANK YOU
    </h1>
    <p class="text-muted mb-10 leading-relaxed">
      Thanks for your message! I'll be in touch soon.
    </p>

    <a
      href="/"
      class="group inline-flex items-center gap-1.5 bg-accent text-white px-6 py-3 font-medium tracking-wide hover:bg-accent/80 transition-colors"
    >
      <Chevron direction="left" class="transition-transform duration-200 group-hover:-translate-x-0.5" />
      Back to Home
    </a>
  </main>

  <Footer />
</Layout>
