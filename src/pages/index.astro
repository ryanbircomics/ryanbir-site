---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Chevron from "../components/Chevron.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("portfolio", ({ data }) => !data.hidden);
---

<Layout title="Ryan Bir — Comic Book Illustrator">
  <Nav />

  <main class="flex-1 flex flex-col">
    <!-- Hero -->
    <section class="max-w-6xl w-full mx-auto px-6 pt-4 pb-4">
      <h1 class="font-display text-7xl md:text-8xl tracking-widest leading-none text-text whitespace-nowrap">
        RYAN BIR
      </h1>
      <p class="mt-3 text-muted text-base max-w-xl leading-relaxed">
        Comic book illustrator. Pencils, inks, and covers for independent and
        publisher projects.
      </p>
    </section>

    <!-- Category Triptych -->
    <section class="flex-1 max-w-6xl w-full mx-auto px-6 pb-6 min-h-0">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 h-full">
        {[
          { slug: "pencils-inks", label: "Pencils & Inks" },
          { slug: "colors", label: "Colors" },
          { slug: "illustrations", label: "Illustrations" },
        ].map((cat) => {
          const featured = allProjects
            .filter((p) => p.data.category === cat.slug)
            .sort((a, b) => a.data.ranking - b.data.ranking)[0];
          const coverImage = featured
            ? `/${featured.data.imageFolderLocation}/cover.jpg`
            : null;
          return (
            <a
              href={`/portfolio/${cat.slug}`}
              class="group relative overflow-hidden bg-surface border border-white/5 hover:border-accent/40 transition-all duration-300 flex items-end min-h-48 animate-fade-in-up"
            >
              {coverImage && (
                <img
                  src={coverImage}
                  alt={cat.label}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              )}
              <div class="relative z-10 p-6 w-full bg-gradient-to-t from-black/80 to-transparent">
                <h2 class="font-display text-4xl tracking-widest text-text leading-none">
                  {cat.label.toUpperCase()}
                </h2>
                <p class="text-accent text-sm mt-2 font-medium inline-flex items-center gap-1">
                  View work
                  <Chevron direction="right" class="transition-transform duration-200 group-hover:translate-x-0.5" />
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>

</Layout>
