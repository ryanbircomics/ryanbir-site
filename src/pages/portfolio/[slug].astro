---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import { readdirSync, existsSync } from "fs";
import { join } from "path";

const CATEGORIES = [
  { slug: "pencils-inks", label: "Pencils & Inks" },
  { slug: "colors", label: "Colors" },
  { slug: "illustrations", label: "Illustrations" },
];

export async function getStaticPaths() {
  const projects = await getCollection("portfolio");

  const CATEGORIES = [
    { slug: "pencils-inks", label: "Pencils & Inks" },
    { slug: "colors", label: "Colors" },
    { slug: "illustrations", label: "Illustrations" },
  ];

  const categoryPaths = CATEGORIES.map((cat) => ({
    params: { slug: cat.slug },
    props: {
      type: "category" as const,
      category: cat,
      projects: projects
        .filter((p) => p.data.category === cat.slug)
        .sort((a, b) => a.data.ranking - b.data.ranking),
    },
  }));

  const projectPaths = projects.map((project) => ({
    params: { slug: project.id },
    props: { type: "project" as const, project },
  }));

  return [...categoryPaths, ...projectPaths];
}

function getProjectImages(imageFolderLocation: string): string[] {
  const folderPath = join(process.cwd(), "public", imageFolderLocation);
  if (!existsSync(folderPath)) return [];
  const files = readdirSync(folderPath).filter((f) =>
    /\.(jpg|jpeg|png)$/i.test(f)
  );
  const cover = files.find((f) => f.toLowerCase() === "cover.jpg");
  const rest = files
    .filter((f) => f.toLowerCase() !== "cover.jpg")
    .sort();
  return cover ? [cover, ...rest] : rest;
}

const { type } = Astro.props;
---

{type === "category" ? (
  (() => {
    const { category, projects } = Astro.props;
    return (
      <Layout
        title={`${category.label} — Ryan Bir`}
        description={`${category.label} work by comic book illustrator Ryan Bir.`}
      >
        <Nav />
        <main class="max-w-6xl mx-auto px-6 py-12">
          <a href="/portfolio" class="text-muted text-sm hover:text-accent transition-colors mb-8 inline-block">
            ← Portfolio
          </a>
          <h1 class="font-display text-5xl md:text-7xl tracking-widest text-text mt-4 mb-16">
            {category.label.toUpperCase()}
          </h1>

          {projects.length === 0 ? (
            <p class="text-muted">No projects yet — check back soon.</p>
          ) : (
            <div class="space-y-24">
              {projects.map((project) => {
                const { title, issueNumber, role, coCredit, coCreditLink, contentLink, imageFolderLocation } = project.data;
                const displayTitle = issueNumber ? `${title} Issue #${issueNumber}` : title;
                const images = getProjectImages(imageFolderLocation);
                return (
                  <section>
                    <!-- Project header -->
                    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-2">
                      <h2 class="font-display text-3xl md:text-4xl tracking-widest text-text">
                        {displayTitle}
                      </h2>
                      {contentLink && (
                        <a
                          href={contentLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-accent text-sm font-medium hover:underline"
                        >
                          Read / Buy →
                        </a>
                      )}
                    </div>
                    <p class="text-muted text-sm mb-1">{role}{coCredit && (
                      <span> · with {coCreditLink ? (
                        <a href={coCreditLink} class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">
                          {coCredit}
                        </a>
                      ) : coCredit}</span>
                    )}</p>

                    <!-- Image grid -->
                    {images.length > 0 ? (
                      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3" data-lightbox-group={project.id}>
                        {images.map((filename) => (
                          <div class="overflow-hidden bg-surface">
                            <img
                              src={`/${imageFolderLocation}/${filename}`}
                              alt={`${displayTitle} — ${filename}`}
                              class="w-full h-auto object-cover hover:opacity-80 transition-opacity cursor-pointer"
                              loading="lazy"
                              data-lightbox-img
                            />
                          </div>
                        ))}
                      </div>
                    ) : (
                      <p class="text-muted text-sm">Images coming soon.</p>
                    )}
                  </section>
                );
              })}
            </div>
          )}
        </main>
        <Footer />

        <div
          id="lightbox"
          class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95"
        >
          <button
            id="lightbox-close"
            aria-label="Close"
            class="absolute top-4 right-4 md:top-6 md:right-6 text-white/80 hover:text-white text-4xl leading-none w-12 h-12 flex items-center justify-center"
          >
            &times;
          </button>
          <button
            id="lightbox-prev"
            aria-label="Previous image"
            class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white text-5xl leading-none w-12 h-12 flex items-center justify-center"
          >
            &#8249;
          </button>
          <img id="lightbox-image" src="" alt="" class="max-w-[90vw] max-h-[85vh] object-contain" />
          <button
            id="lightbox-next"
            aria-label="Next image"
            class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 text-white/80 hover:text-white text-5xl leading-none w-12 h-12 flex items-center justify-center"
          >
            &#8250;
          </button>
        </div>

        <script>
          const lightbox = document.getElementById("lightbox");
          const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement | null;
          const closeBtn = document.getElementById("lightbox-close");
          const prevBtn = document.getElementById("lightbox-prev");
          const nextBtn = document.getElementById("lightbox-next");

          if (lightbox && lightboxImage && closeBtn && prevBtn && nextBtn) {
            let currentImages: HTMLImageElement[] = [];
            let currentIndex = 0;

            const show = (index: number) => {
              currentIndex = (index + currentImages.length) % currentImages.length;
              const img = currentImages[currentIndex];
              lightboxImage.src = img.src;
              lightboxImage.alt = img.alt;
            };

            const open = (images: HTMLImageElement[], index: number) => {
              currentImages = images;
              show(index);
              lightbox.classList.remove("hidden");
              lightbox.classList.add("flex");
              document.body.style.overflow = "hidden";
            };

            const close = () => {
              lightbox.classList.add("hidden");
              lightbox.classList.remove("flex");
              document.body.style.overflow = "";
            };

            document.querySelectorAll("[data-lightbox-group]").forEach((group) => {
              const images = Array.from(group.querySelectorAll("img[data-lightbox-img]")) as HTMLImageElement[];
              images.forEach((img, i) => {
                img.addEventListener("click", () => open(images, i));
              });
            });

            closeBtn.addEventListener("click", close);
            prevBtn.addEventListener("click", () => show(currentIndex - 1));
            nextBtn.addEventListener("click", () => show(currentIndex + 1));
            lightbox.addEventListener("click", (e) => {
              if (e.target === lightbox) close();
            });
            document.addEventListener("keydown", (e) => {
              if (lightbox.classList.contains("hidden")) return;
              if (e.key === "Escape") close();
              if (e.key === "ArrowLeft") show(currentIndex - 1);
              if (e.key === "ArrowRight") show(currentIndex + 1);
            });
          }
        </script>
      </Layout>
    );
  })()
) : (
  (() => {
    const { project } = Astro.props;
    const { title, issueNumber, role, coCredit, coCreditLink, contentLink, imageFolderLocation, category } =
      project.data;
    const displayTitle = issueNumber ? `${title} Issue #${issueNumber}` : title;
    const coverImage = `/${imageFolderLocation}/cover.jpg`;
    const catLabel = CATEGORIES.find((c) => c.slug === category)?.label ?? category;
    return (
      <Layout
        title={`${displayTitle} — Ryan Bir`}
        description={`${displayTitle} — ${role} by Ryan Bir`}
      >
        <Nav />
        <main class="flex-1 max-w-6xl mx-auto px-6 py-16">
          <a href={`/portfolio/${category}`} class="text-muted text-sm hover:text-accent transition-colors mb-8 inline-block">
            ← {catLabel}
          </a>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mt-6">
            <div class="aspect-[3/4] bg-surface rounded-lg overflow-hidden">
              <img
                src={coverImage}
                alt={displayTitle}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="flex flex-col justify-start pt-4">
              <h1 class="font-display text-5xl md:text-6xl tracking-widest text-text leading-none">
                {displayTitle}
              </h1>
              <dl class="mt-8 space-y-4">
                <div>
                  <dt class="text-muted text-xs uppercase tracking-widest">Role</dt>
                  <dd class="text-text mt-1">{role}</dd>
                </div>
                {coCredit && (
                  <div>
                    <dt class="text-muted text-xs uppercase tracking-widest">With</dt>
                    <dd class="text-text mt-1">
                      {coCreditLink ? (
                        <a href={coCreditLink} class="text-accent hover:underline" target="_blank" rel="noopener noreferrer">
                          {coCredit}
                        </a>
                      ) : coCredit}
                    </dd>
                  </div>
                )}
              </dl>
              {contentLink && (
                <a
                  href={contentLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-10 inline-block bg-accent text-white px-6 py-3 text-sm font-medium tracking-wide hover:bg-accent/80 transition-colors self-start"
                >
                  Read / Buy →
                </a>
              )}
            </div>
          </div>
        </main>
        <Footer />
      </Layout>
    );
  })()
)}
