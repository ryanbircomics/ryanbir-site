---
interface Props {
  direction?: "left" | "right";
  class?: string;
}
const { direction = "right", class: className = "" } = Astro.props;
const d = direction === "left" ? "M14 17l-5-5 5-5" : "M6 17l5-5-5-5";
---

<svg
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`inline-block w-3 h-3 shrink-0 ${className}`}
  aria-hidden="true"
>
  <path d={d} />
</svg>
