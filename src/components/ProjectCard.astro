---
interface Props {
  title: string;
  issueNumber?: number;
  date: string;
  role: string;
  coCredit?: string;
  coCreditLink?: string;
  contentLink?: string;
  imageFolderLocation: string;
  slug: string;
}

const {
  title,
  issueNumber,
  date,
  role,
  coCredit,
  coCreditLink,
  contentLink,
  imageFolderLocation,
  slug,
} = Astro.props;

const coverImage = `/${imageFolderLocation}/cover.jpg`;
const displayTitle = issueNumber ? `${title} #${issueNumber}` : title;
---

<article class="group bg-surface rounded-lg overflow-hidden border border-white/5 hover:border-accent/40 transition-all duration-300">
  <a href={`/portfolio/${slug}`} class="block">
    <div class="aspect-[3/4] overflow-hidden bg-black/40">
      <img
        src={coverImage}
        alt={displayTitle}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
    <div class="p-4">
      <h3 class="font-display text-xl tracking-wide text-text group-hover:text-accent transition-colors">
        {displayTitle}
      </h3>
      <p class="text-muted text-sm mt-1">{role}</p>
      {coCredit && (
        <p class="text-muted text-xs mt-1">
          with{" "}
          {coCreditLink ? (
            <a
              href={coCreditLink}
              class="text-accent hover:underline"
              target="_blank"
              rel="noopener noreferrer"
              onclick="event.stopPropagation()"
            >
              {coCredit}
            </a>
          ) : (
            coCredit
          )}
        </p>
      )}
      <p class="text-muted text-xs mt-2">{date}</p>
    </div>
  </a>
  {contentLink && (
    <div class="px-4 pb-4">
      <a
        href={contentLink}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent text-xs font-medium hover:underline"
      >
        Read / Buy →
      </a>
    </div>
  )}
</article>
